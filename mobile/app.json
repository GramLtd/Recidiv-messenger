{
  "expo": {
    "name": "Recidivist",
    "slug": "recidivist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "lol.recidivist.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы отправлять фото и менять аватарку",
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен, чтобы отправлять картинки",
        "NSMicrophoneUsageDescription": "Микрофон нужен для голосовых сообщений",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lol.recidivist.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "CAMERA",
        "RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#ff2d3d"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна для видеосообщений-кружков и фото",
          "microphonePermission": "Микрофон нужен для голосовых и видеосообщений",
          "recordAudioAndroid": true
        }
      ]
    ],
    "scheme": "recidivist",
    "backgroundColor": "#000000",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://recidivist.lol"
    }
  }
}