# --- core ---
PORT=4000
PUBLIC_URL=https://your-domain.com
JWT_SECRET=change-me-to-a-long-random-string
# NODE_ENV=production

# Comma-separated emails that become admins on registration.
# In dev, when this is empty, the FIRST registered user becomes admin.
ADMIN_EMAILS=you@example.com

# DB_PATH=./data/recidivist.db
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_MB=50

# --- email (verification codes). Without SMTP codes are printed to the console ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Recidivist <no-reply@your-domain.com>

# --- payments ---
# xRocket Pay API key (https://t.me/xrocket → Rocket Pay → create app).
# Webhook URL to set in xRocket: ${PUBLIC_URL}/api/webhooks/xrocket
# XROCKET_API_KEY=

# Project TON wallet that receives TON Connect payments
# TON_WALLET_ADDRESS=UQ...
# TONCENTER_API_KEY=

# "Test payment" button in the wallet (default: on unless NODE_ENV=production)
# ALLOW_TEST_PAYMENTS=false

# --- music search & recognition ---
# Internet Archive and Deezer previews work without keys.
# Jamendo (full CC-licensed tracks): free client id at https://devportal.jamendo.com
# JAMENDO_CLIENT_ID=
# "Shazam"-like recognition via AudD: token at https://dashboard.audd.io
# AUDD_API_TOKEN=
